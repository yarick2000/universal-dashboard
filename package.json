{
  "name": "universal-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "analyze": "cross-env ANALYZE=true next build",
    "dev": "cross-env NODE_ENV=development && npm run tools:apply-config -- -s local -t development && npm run build:workers -- -s && next dev --turbopack",
    "build": "cross-env NODE_ENV=production && npm run tools:apply-config -- -s production -t production &&  npm run build:workers -- -m && next build",
    "build:workers": "npx tsx src/tools/build-workers",
    "start": "next start",
    "lint": "eslint .",
    "husky:init": "husky init",
    "test": "cross-env NODE_ENV=test && jest --passWithNoTests",
    "test:watch": "cross-env NODE_ENV=development && jest --watch",
    "test:coverage": "cross-env NODE_ENV=development && jest --coverage",
    "test:debug": "cross-env NODE_ENV=development && jest --runInBand --detectOpenHandles --forceExit",
    "cache:clear": "rimraf .next/cache",
    "tools:apply-config": "npx tsx src/tools/apply-config",
    "tools:supabase-types": "npx tsx src/tools/supabase-types"
  },
  "dependencies": {
    "@next/bundle-analyzer": "15.5.2",
    "@next/third-parties": "15.5.2",
    "@opentelemetry/api-logs": "^0.57.2",
    "@opentelemetry/instrumentation": "^0.57.2",
    "@opentelemetry/sdk-logs": "^0.57.2",
    "@supabase/supabase-js": "2.56.1",
    "@vercel/analytics": "^1.5.0",
    "@vercel/otel": "^1.13.0",
    "@vercel/speed-insights": "^1.2.0",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "1.2.2",
    "@radix-ui/react-alert-dialog": "1.1.4",
    "@radix-ui/react-aspect-ratio": "1.1.1",
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-collapsible": "1.1.2",
    "@radix-ui/react-context-menu": "2.2.4",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-hover-card": "1.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-menubar": "1.1.4",
