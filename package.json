    "eslint-config-next": "15.5.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-tailwindcss": "^4.0.0-beta.0",
    "husky": "9.1.7",
    "jest": "30.1.1",
    "jest-environment-jsdom": "30.1.1",
    "rimraf": "6.0.1",
    "tailwindcss": "4.1.12",
    "ts-jest": "29.4.1",
    "ts-node": "^10.9.2",
    "tsx": "4.20.5",
