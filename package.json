    "react-hook-form": "^7.60.0",
    "react-resizable-panels": "^2.1.7",
    "recharts": "2.15.4",
    "sonner": "^1.7.4",
    "serialize-error": "12.0.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "ts-command-line-args": "2.5.1",
    "ts-deepmerge": "7.0.3",
    "typed-inject": "5.0.0",
